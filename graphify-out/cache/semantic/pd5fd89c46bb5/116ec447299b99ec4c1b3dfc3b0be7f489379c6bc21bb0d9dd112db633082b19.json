{"nodes": [{"id": "security_security_policy", "label": "Security Policy", "file_type": "document", "source_file": "SECURITY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "security_localhost_boundary", "label": "Localhost Trust Boundary", "file_type": "rationale", "source_file": "SECURITY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The local API has no authentication by design: it binds to localhost and the security boundary is the machine and the user account. Treating a local tool as multi-user would mean pretending it is a service. Anything that defeats the localhost boundary is a vulnerability."}, {"id": "security_verification_defeat", "label": "Verification Defeat Treated as Security Issue", "file_type": "concept", "source_file": "SECURITY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verification is the guarantee the tool is built around; a way to make a migration pass verification while the data is wrong is classified as a security issue, not just a bug."}], "edges": [{"source": "security_security_policy", "target": "docs_safety_safety_guarantees", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SECURITY.md", "source_location": null, "weight": 1.0}, {"source": "security_verification_defeat", "target": "docs_safety_verified_success", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SECURITY.md", "source_location": null, "weight": 1.0}, {"source": "docs_safety_stored_credentials", "target": "security_localhost_boundary", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SECURITY.md", "source_location": null, "weight": 1.0}], "hyperedges": []}
{"nodes": [{"id": "claude_project_rules", "label": "CLAUDE.md Project Rules", "file_type": "document", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_english_code_turkish_ui", "label": "English Code / Turkish UI Split", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Code, comments, commits, docs and engine log text are English; anything a user reads on the page is Turkish, including wwwroot/index.html, the TR dictionary in app.js, and the PDF report strings even though they live in C#."}, {"id": "claude_message_codes_wire_format", "label": "Message Codes as Wire Format", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The engine never formats a sentence for a user: it reports English Text plus a stable Code and Args, and the browser translates by code via the TR map in app.js. A missing TR entry silently falls back to English; renaming a code silently drops its translation, so codes are added, never repurposed. Engine codes (Migrator.Core/MessageCode.cs) are kept apart from application codes (Migrator.App/AppMessageCode.cs) because a batch is not something the engine knows about."}, {"id": "claude_no_build_step_ui", "label": "No-Build-Step Embedded UI", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "wwwroot is plain HTML/CSS/JS embedded into the assembly so the published single-file executable carries its own interface. No CDN, no external fonts, no npm \u2014 the app is offline and localhost-only. The PDF report ships its own font (Assets/DejaVuSans.ttf) so Turkish letters render on a machine with no fonts installed."}, {"id": "claude_engine_prohibitions", "label": "What the Engine Is Not Allowed to Do", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never report success it did not earn; never leave a half-migrated target; never relax a check by default. A change that makes a run more likely to appear to succeed is a change in the wrong direction, however convenient."}], "edges": [{"source": "claude_project_rules", "target": "contributing_contributing_guide", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_project_rules", "target": "docs_safety_safety_guarantees", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_project_rules", "target": "_claude_skills_verify_ui_skill_verify_ui", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "src_migrator_app_wwwroot_index_migrator_page", "target": "claude_english_code_turkish_ui", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_message_codes_wire_format", "target": "claude_english_code_turkish_ui", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "src_migrator_app_assets_dejavusans_license_bitstream_vera_license", "target": "claude_no_build_step_ui", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_engine_prohibitions", "target": "docs_safety_safety_guarantees", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_engine_prohibitions", "target": "docs_safety_verified_success", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_engine_prohibitions", "target": "docs_safety_atomic_rollback", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_engine_prohibitions", "target": "docs_safety_escape_hatches", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}], "hyperedges": []}
<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Migrator.Core\Migrator.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="8.0.11" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <!-- The desktop window. Photino wraps the OS WebView (WebView2 on Windows, WebKitGTK
         on Linux, WKWebView on macOS) so the same wwwroot/ page renders in a native window
         and, later, over HTTP. It ships no browser engine of its own. -->
    <PackageReference Include="Photino.NET" Version="4.0.16" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- The UI is embedded into the assembly: the publish output works without a wwwroot
       folder. Development uses the physical files (see Program.cs), so they stay Content too. -->
  <PropertyGroup>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="wwwroot/**" />
  </ItemGroup>

  <!-- The PDF report's font travels inside the assembly: the published binary has to draw
       the same Turkish letters on a machine that has no fonts installed at all. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets/DejaVuSans.ttf" />
    <None Include="Assets/DejaVuSans-LICENSE.txt" />
  </ItemGroup>

  <!-- Single-file publish: `dotnet publish -c Release -r win-x64` produces one exe.
       Regular build/run without a RuntimeIdentifier is unaffected. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <!-- Never hosted on IIS; don't generate web.config. -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Kept out of the publish output so nothing sits next to the exe: the UI is served
         from the embedded copy, and appsettings differs in nothing from the defaults. -->
    <Content Update="wwwroot/**" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.json;appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
